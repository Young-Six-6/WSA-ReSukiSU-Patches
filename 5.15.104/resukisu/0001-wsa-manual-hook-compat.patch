+/*
+ * Some Manual Hook kernels load KSU after init's second-stage exec.  In that
+ * case the normal boot-time policy setup is missed; initialize it once at
+ * the first requested transition to the KSU domain.
+ */
+static DEFINE_MUTEX(ksu_deferred_policy_lock);
