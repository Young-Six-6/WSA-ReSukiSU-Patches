+void ksu_ensure_sepolicy(void)
+{
+    mutex_lock(&ksu_deferred_policy_lock);
+    if (!ksu_deferred_policy_attempted) {
+        ksu_deferred_policy_attempted = true;
+        pr_warn("deferred KSU sepolicy initialization\n");
+        apply_kernelsu_rules();
+        cache_sid();
+        setup_ksu_cred();
+    }
+    mutex_unlock(&ksu_deferred_policy_lock);
