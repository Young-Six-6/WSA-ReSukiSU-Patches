+/* Manual-hook WSA kernels can miss init's second-stage exec. */
+static DEFINE_MUTEX(ksu_deferred_policy_lock);
+static bool ksu_deferred_policy_attempted;
+
 #ifdef CONFIG_KSU_SUSFS
 // only susfs need that
 static u32 cached_zygote_next_sid __read_mostly = 0;
@@ -60,12 +66,36 @@ static int transive_to_domain(const char *domain, struct cred *cred, bool clear_
     return error;
 }
 
+void ksu_ensure_sepolicy(void)
+{
+    mutex_lock(&ksu_deferred_policy_lock);
+    if (!ksu_deferred_policy_attempted) {
+        ksu_deferred_policy_attempted = true;
+        pr_warn("deferred KSU sepolicy initialization\n");
+        apply_kernelsu_rules();
+        cache_sid();
+        setup_ksu_cred();
+    }
+    mutex_unlock(&ksu_deferred_policy_lock);
+}
+
 void setup_selinux(const char *domain, struct cred *cred)
 {
-    if (transive_to_domain(domain, cred, false)) {
-        pr_err("transive domain failed.\n");
+    int error = transive_to_domain(domain, cred, false);
+
+    if (!error)
         return;
+
+    if (!strcmp(domain, KERNEL_SU_CONTEXT)) {
+        ksu_ensure_sepolicy();
+        error = transive_to_domain(domain, cred, false);
+        if (!error) {
+            pr_info("deferred KSU sepolicy transition succeeded\n");
+            return;
+        }
     }
+
+    pr_err("transive domain failed.\n");
 }
 
