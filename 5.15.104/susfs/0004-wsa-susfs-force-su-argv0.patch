--- a/KernelSU/kernel/feature/sucompat.c
+++ b/KernelSU/kernel/feature/sucompat.c
@@ -178,6 +178,29 @@ static char __user *empty_user_path(void)
     return userspace_stack_buffer("", sizeof(""));
 }

+static int ksu_sucompat_set_argv0(struct user_arg_ptr *argv)
+{
+    static const char su_arg0[] = "su";
+    char __user *user_arg0;
+
+    if (!argv || !argv->ptr.native)
+        return -EFAULT;
+
+    user_arg0 = userspace_stack_buffer(su_arg0, sizeof(su_arg0));
+    if (!user_arg0)
+        return -EFAULT;
+
+#ifdef CONFIG_COMPAT
+    if (unlikely(argv->is_compat)) {
+        compat_uptr_t compat_arg0 = ptr_to_compat(user_arg0);
+
+        return put_user(compat_arg0, (compat_uptr_t __user *)argv->ptr.compat);
+    }
+#endif
+    return put_user((const char __user *)user_arg0,
+                    (const char __user * __user *)argv->ptr.native);
+}
+
 static bool is_ksud_exists()
 {
     struct path path;
@@ -399,6 +422,13 @@ static inline int do_ksu_handle_execveat_sucompat(int *fd, const char *filename,
     if (likely(!is_su_path(filename)))
         return 0;

+    /* ksud selects its su applet from argv[0], not the rewritten filename. */
+    ret = ksu_sucompat_set_argv0(argv);
+    if (ret) {
+        pr_err("sucompat: failed to restore su argv[0]: %d\n", ret);
+        return 0;
+    }
+

     ret = escape_with_root_profile();

     pending_sucompat = ksu_sulog_capture_sucompat_manual(filename, *argv, GFP_KERNEL);
